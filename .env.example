# Strapi (CMS) genel adresi
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# toptan3dcim-backend (Strapi) genel adresi - checkout sayfası ödeme
# başlatma isteğini (POST /api/payment/initiate) bu adrese gönderir.
NEXT_PUBLIC_BACKEND_URL=http://localhost:1337

# Kart ile ödeme (checkout) özelliğini açar/kapatır. "true" değilse sepetteki
# "Kart ile Öde" butonu render edilmez ve /checkout sayfasına erişim engellenir.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Firmanıza Özel Ürünler teklif formu (server-side SMTP)
# Gerçek değerleri yalnızca deployment ortamında tanımlayın.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
# Optional legacy fallbacks used by the existing Kesiolabs mail flow:
# SMTP_FROM=
# CONTACT_TO=

# Customer account BFF: secrets are server-side only
CUSTOMER_ACCOUNTS_ENABLED=false
FIGURINE_REQUESTS_ENABLED=false
CUSTOMER_STRAPI_INTERNAL_URL=http://127.0.0.1:1337
CUSTOMER_BFF_SECRET=
CUSTOMER_PUBLIC_ORIGIN=http://127.0.0.1:3210
# Only behind a trusted proxy which REPLACES this header and blocks direct access.
# Unconfigured: conservative shared client bucket plus email limits.
CUSTOMER_TRUSTED_CLIENT_IP_HEADER=
# Local/staging rewrite override; unset preserves the existing production target.
BACKEND_PROXY_URL=
